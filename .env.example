# ==============================================================================
# HackMate Root Environment Configuration Template
# Copy this file to .env for local overrides (never commit real credentials).
# ==============================================================================

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Settings (public variables must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# AI Provider Settings
# ==============================================================================
#
# Provider: Google Gemini (FREE TIER — recommended)
#   1. Get a free API key at: https://aistudio.google.com/app/apikey
#   2. Set GEMINI_API_KEY below.
#   3. Leave AI_MODEL blank to use the default (gemini-3.8-flash).
#
# If NO key is set, the system runs in deterministic fallback mode.
# Fallback output is always labelled [FALLBACK] — it is never real AI output.
#
GEMINI_API_KEY=

# Optional: override Gemini model name (e.g. gemini-3.8-flash)
# Leave blank to use the default free-tier model.
AI_MODEL=

# Legacy / unused keys (kept for future provider support)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ==============================================================================
# Runner Sandbox Settings
# ==============================================================================
RUNNER_TIMEOUT_SECONDS=120
RUNNER_WORKSPACE_ROOT=./generated
PREVIEW_HOST=localhost
PREVIEW_BASE_PORT=4173
