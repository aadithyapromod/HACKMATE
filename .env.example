# ==============================================================================
# HackMate Root Environment Configuration Template
# Copy this file to .env for local overrides (never commit real credentials).
# ==============================================================================

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Settings (public variables must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI Provider Settings (Optional for basic scaffold; mock fallback used if not provided)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=mock-v1

# Runner Sandbox Settings
RUNNER_TIMEOUT_SECONDS=120
RUNNER_WORKSPACE_ROOT=./generated
PREVIEW_HOST=localhost
PREVIEW_BASE_PORT=4173
