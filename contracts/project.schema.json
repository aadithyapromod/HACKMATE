{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hackmate.local/schemas/project.schema.json",
  "title": "Project",
  "description": "HackMate Project entity definition and creation payload",
  "type": "object",
  "required": ["id", "idea", "status", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the project",
      "examples": ["project-123"]
    },
    "idea": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "User hackathon project concept description",
      "examples": ["Build a student hackathon matching website"]
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "planning",
        "generating",
        "building",
        "testing",
        "repairing",
        "completed",
        "failed"
      ],
      "description": "Current lifecycle status of the project",
      "examples": ["created"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of creation",
      "examples": ["2026-10-23T10:00:00Z"]
    }
  },
  "additionalProperties": false
}
